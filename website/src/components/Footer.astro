---
/**
 * Same rule as the nav: internal links follow the page's language. A Turkish
 * reader clicking "Features" in the footer used to land on the English page.
 * External links and mailto are left alone.
 */
const isTr = Astro.url.pathname === '/tr' || Astro.url.pathname.startsWith('/tr/')
const p = (href: string): string => (isTr ? `/tr${href}` : href)

const t = isTr
  ? {
      product: 'Ürün',
      features: 'Özellikler',
      tools: 'Güvenlik araçları',
      security: 'Güvenlik',
      download: 'İndir',
      changelog: 'Sürüm notları',
      documentation: 'Dokümanlar',
      gettingStarted: 'Başlarken',
      importExport: 'İçe & dışa aktarma',
      protocols: 'Protokoller',
      scripts: 'Betikler & testler',
      certificates: 'Sertifikalar',
      community: 'Topluluk',
      releases: 'Sürümler',
      issues: 'Sorunlar',
      contact: 'İletişim',
      company: 'Şirket',
      license: 'EULA & Lisans',
      privacy: 'Gizlilik Politikası',
    }
  : {
      product: 'Product',
      features: 'Features',
      tools: 'Security tools',
      security: 'Security',
      download: 'Download',
      changelog: 'Changelog',
      documentation: 'Documentation',
      gettingStarted: 'Getting started',
      importExport: 'Import & export',
      protocols: 'Protocols',
      scripts: 'Scripts & tests',
      certificates: 'Certificates',
      community: 'Community',
      releases: 'Releases',
      issues: 'Issues',
      contact: 'Contact',
      company: 'Company',
      license: 'EULA & License',
      privacy: 'Privacy Policy',
    }

const cols = [
  {
    title: t.product,
    links: [
      { href: p('/features'), label: t.features },
      { href: p('/security-tools'), label: t.tools },
      { href: p('/security'), label: t.security },
      { href: p('/download'), label: t.download },
      { href: p('/docs/changelog'), label: t.changelog },
    ],
  },
  {
    title: t.documentation,
    links: [
      { href: p('/docs/getting-started'), label: t.gettingStarted },
      { href: p('/docs/import-formats'), label: t.importExport },
      { href: p('/docs/protocols'), label: t.protocols },
      { href: p('/docs/ws-security'), label: 'WS-Security' },
      { href: p('/docs/scripts'), label: t.scripts },
      { href: p('/docs/certificates'), label: t.certificates },
    ],
  },
  {
    title: t.community,
    links: [
      { href: 'https://github.com/apinizer/testnizer', label: 'GitHub', external: true },
      { href: 'https://github.com/apinizer/testnizer/releases', label: t.releases, external: true },
      { href: 'https://github.com/apinizer/testnizer/issues', label: t.issues, external: true },
      { href: 'mailto:info@testnizer.com', label: t.contact },
    ],
  },
  {
    title: t.company,
    links: [
      { href: 'https://apinizer.com', label: 'Apinizer', external: true },
      { href: p('/license'), label: t.license },
      { href: p('/privacy'), label: t.privacy },
    ],
  },
]
---

<footer class="mt-32 border-t border-border bg-bg-soft">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-5">
      <div class="col-span-2 md:col-span-1">
        <div class="flex items-center gap-2.5 font-semibold tracking-tight">
          <img src="/logo.png" class="h-7 w-7" alt="" />
          <span class="text-text">Testnizer</span>
        </div>
        <p class="mt-3 text-sm text-text-muted">
          The offline API client for teams requiring absolute data privacy.
        </p>
        <p class="mt-2 text-xs text-text-soft">
          A free community project by{' '}
          <a href="https://apinizer.com" target="_blank" rel="noopener" class="underline decoration-dotted underline-offset-2 hover:text-text-muted">Apinizer</a>.
        </p>
      </div>

      {cols.map((col) => (
        <div>
          <h4 class="text-sm font-semibold text-text">{col.title}</h4>
          <ul class="mt-3 space-y-2">
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.external ? '_blank' : undefined}
                  rel={l.external ? 'noopener' : undefined}
                  class="text-sm text-text-muted transition-colors hover:text-text"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-border pt-6 text-xs text-text-soft md:flex-row md:items-center md:justify-between">
      <p>
        © {new Date().getFullYear()}{' '}
        <a href="https://apinizer.com" target="_blank" rel="noopener" class="hover:text-text-muted underline decoration-dotted underline-offset-2">Apinizer</a>.
        {' '}Testnizer is a free project by Apinizer — no subscription, no telemetry, no vendor lock-in.
      </p>
      <p>
        Built in Türkiye. Other trademarks (Postman, SoapUI, jwt.io) referenced for compatibility only.
      </p>
    </div>
  </div>
</footer>
