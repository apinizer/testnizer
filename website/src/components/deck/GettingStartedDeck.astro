---
/**
 * Testnizer getting-started (training) deck. Every step slide answers three
 * questions — what you do, where you click, what you will see — and every
 * step can be followed as written on a fresh install: the first requests go
 * to httpbin.org (as in the Getting started guide), and the mock, MCP,
 * security scan and AI Chat steps run against Testnizer's own local mock
 * servers, so no provider key, token or third-party server is needed.
 *
 * Button names are the app's own labels (src/renderer/lib/i18n.ts) in both
 * languages. Mock panels are sketches with sample data; the REST example
 * endpoints are the real preset (components/mock/mock-http-presets.ts).
 */
import DeckLayout from './DeckLayout.astro'
import Slide from './Slide.astro'
import T from './T.astro'
import { icons } from '../icons'
import { langOf } from '../../lib/presentations'

const deck = 'testnizer-getting-started'
const isTr = langOf(Astro.url.pathname) === 'tr'
const p = (href: string): string => (isTr ? `/tr${href}` : href)
const STEPS = 14

const ico = {
  target: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2"/></svg>`,
  pointer: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m4 4 7.07 17 2.51-7.39L21 11.07z"/></svg>`,
  eye: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>`,
}
const K = {
  do: isTr ? 'Ne yapacaksınız' : 'What you do',
  click: isTr ? 'Nereye tıklayacaksınız' : 'Where you click',
  see: isTr ? 'Ne göreceksiniz' : 'What you will see',
}
const stepNo = (n: number): string => `${String(n).padStart(2, '0')} / ${STEPS}`

const agenda = [
  { en: 'Install and create a project', tr: 'Kurun ve proje oluşturun', sen: 'macOS · Windows · Linux', str: 'macOS · Windows · Linux' },
  { en: 'Send your first request', tr: 'İlk isteğinizi gönderin', sen: 'httpbin.org', str: 'httpbin.org' },
  { en: 'Environments and {{variables}}', tr: 'Ortamlar ve {{değişkenler}}', sen: 'one value, every request', str: 'tek değer, her istek' },
  { en: 'Authorization', tr: 'Yetkilendirme', sen: 'Bearer token, inherited', str: 'Bearer token, miras' },
  { en: 'Scripts and tests', tr: "Script'ler ve testler", sen: 'pm.test, assertions', str: 'pm.test, doğrulamalar' },
  { en: 'Run a folder, export the report', tr: 'Klasörü çalıştırın, raporu alın', sen: 'Runner · HTML', str: 'Runner · HTML' },
  { en: 'An HTTP mock server', tr: 'Bir HTTP mock sunucu', sen: '127.0.0.1:3001', str: '127.0.0.1:3001' },
  { en: 'An MCP mock server, connected', tr: 'Bir MCP mock sunucu, bağlı', sen: 'Echo preset', str: 'Echo hazır ayarı' },
  { en: 'Call an MCP tool', tr: 'Bir MCP aracı çağırın', sen: 'echo · pm.mcp', str: 'echo · pm.mcp' },
  { en: 'Scan the MCP server', tr: 'MCP sunucusunu tarayın', sen: 'A–F report', str: 'A–F rapor' },
  { en: 'AI Chat with MCP tools', tr: 'MCP araçlarıyla AI Chat', sen: 'no API key', str: 'API anahtarı yok' },
  { en: 'Import from Postman', tr: "Postman'den içe aktarın", sen: 'file, folder or .zip', str: 'dosya, klasör ya da .zip' },
  { en: 'Work as a team with Git', tr: 'Git ile ekip olarak çalışın', sen: 'commit, push, pull', str: 'commit, push, pull' },
  { en: 'Shortcuts and tips', tr: 'Kısayollar ve ipuçları', sen: 'Cmd/Ctrl + …', str: 'Cmd/Ctrl + …' },
]

const shortcuts = [
  { k: ['Ctrl/Cmd', 'Enter'], en: 'Run the active request', tr: 'Etkin isteği çalıştır' },
  { k: ['Ctrl/Cmd', 'S'], en: 'Save the request', tr: 'İsteği kaydet' },
  { k: ['Ctrl/Cmd', 'K'], en: 'Command palette', tr: 'Komut paleti' },
  { k: ['?'], en: 'Every shortcut, on one sheet', tr: 'Tüm kısayollar tek sayfada' },
  { k: ['Ctrl/Cmd', 'N'], en: 'New request tab', tr: 'Yeni istek sekmesi' },
  { k: ['Ctrl/Cmd', 'L'], en: 'Focus the URL bar', tr: 'URL çubuğuna odaklan' },
  { k: ['Ctrl/Cmd', 'B'], en: 'Show or hide the sidebar', tr: 'Kenar çubuğunu aç / kapat' },
  { k: ['Ctrl/Cmd', 'Alt', 'C'], en: 'Show or hide the Console', tr: "Konsol'u aç / kapat" },
  { k: ['Ctrl/Cmd', 'O'], en: 'Import', tr: 'İçeri Aktar' },
  { k: ['Ctrl/Cmd', ','], en: 'Settings', tr: 'Ayarlar' },
]

const next = [
  { href: '/docs/getting-started', icon: icons.fileText, en: 'Getting started', tr: 'Başlarken' },
  { href: '/docs/variables', icon: icons.hash, en: 'Variables and environments', tr: 'Değişkenler ve ortamlar' },
  { href: '/docs/scripts', icon: icons.terminal, en: 'Scripts — the pm.* API', tr: "Script'ler — pm.* API'si" },
  { href: '/docs/cli-and-automation', icon: icons.repeat, en: 'Runner, Test Suites, schedules', tr: 'Runner, Test Paketleri, zamanlama' },
  { href: '/docs/mock-server', icon: icons.server, en: 'Mock servers', tr: 'Mock sunucular' },
  { href: '/docs/protocols/mcp', icon: icons.plug, en: 'MCP client and security scan', tr: 'MCP istemcisi ve güvenlik taraması' },
  { href: '/docs/protocols/ai-chat', icon: icons.bot, en: 'AI Chat', tr: 'AI Chat' },
  { href: '/docs/import-formats', icon: icons.download, en: 'Import formats', tr: 'İçe aktarma biçimleri' },
  { href: '/docs/git-branches', icon: icons.gitBranch, en: 'Git and branches', tr: 'Git ve dallar' },
]
---

<DeckLayout slug={deck}>

  <!-- 01 · Cover -->
  <Slide n={1} deck={deck} bare label={{ en: 'Cover', tr: 'Kapak' }} class="cover">
    <div class="glow-bg"></div>
    <div class="dots-bg"></div>
    <div class="pad">
      <div class="cover-top anim">
        <span class="wordmark"><i class="logo-img lg"></i>Testnizer</span>
        <span class="cover-meta"><T en="Training · hands-on · v1.6.0" tr="Eğitim · uygulamalı · v1.6.0" /></span>
      </div>
      <div class="cover-main">
        <div class="cover-copy" style="width:1180px">
          <p class="eyebrow anim" style="--i:1"><T en="Getting started" tr="Başlarken" /></p>
          <h1 class="cover-title anim" style="--i:2;margin-top:20px"><T en="From install to your first <span class='grad'>MCP tool call</span> — step by step." tr="Kurulumdan ilk <span class='grad'>MCP araç çağrınıza</span> — adım adım." /></h1>
          <p class="lead anim" style="--i:3"><T en="Fourteen short steps. Each one says <b>what you do</b>, <b>where you click</b> and <b>what you will see</b>. After the first requests everything runs on your own machine — no account, no API key, no tokens spent." tr="On dört kısa adım. Her biri <b>ne yapacağınızı</b>, <b>nereye tıklayacağınızı</b> ve <b>ne göreceğinizi</b> söyler. İlk isteklerden sonrası tamamen kendi makinenizde çalışır — hesap yok, API anahtarı yok, harcanan token yok." /></p>
        </div>
      </div>
      <div class="cover-foot anim" style="--i:4">
        <div class="pills">
          <span class="pill"><T en="≈ 60–90 minutes" tr="≈ 60–90 dakika" /></span>
          <span class="pill">Testnizer 1.6.0</span>
          <span class="pill">macOS 13+ · Windows · Linux</span>
        </div>
        <span class="cover-os"><T en="Press <kbd>→</kbd> to start" tr="Başlamak için <kbd>→</kbd>" /></span>
      </div>
    </div>
  </Slide>

  <!-- 02 · Agenda -->
  <Slide n={2} deck={deck} label={{ en: 'The fourteen steps', tr: 'On dört adım' }}>
    <div class="pad">
      <p class="eyebrow anim"><T en="The plan" tr="Plan" /></p>
      <h2 class="title anim" style="--i:1"><T en="Fourteen steps, <span class='grad'>each one a few minutes.</span>" tr="On dört adım, <span class='grad'>her biri birkaç dakika.</span>" /></h2>
      <div class="content">
        <div class="agenda anim" style="--i:2">
          {agenda.map((a) => <div><span>{isTr ? a.tr : a.en}<small>{isTr ? a.str : a.sen}</small></span></div>)}
        </div>
      </div>
      <p class="body-copy anim" style="--i:3;margin-top:22px"><T en="You need Testnizer 1.6.0 and an internet connection for steps 2–4 (they call <code>httpbin.org</code>). Everything from step 7 on talks to servers that Testnizer itself runs on <code>127.0.0.1</code>." tr="Testnizer 1.6.0 ve 2–4. adımlar için internet bağlantısı gerekir (<code>httpbin.org</code>'u çağırırlar). 7. adımdan sonrası, Testnizer'ın kendisinin <code>127.0.0.1</code> üzerinde çalıştırdığı sunucularla konuşur." /></p>
    </div>
  </Slide>

  <!-- 03 · Step 1 · Install -->
  <Slide n={3} deck={deck} label={{ en: 'Step 1 — Install and create a project', tr: '1. adım — Kurun ve proje oluşturun' }}>
    <div class="pad">
      <p class="eyebrow anim"><span class="step-no">{stepNo(1)}</span><T en="Install" tr="Kurulum" /></p>
      <h2 class="title sm anim" style="--i:1"><T en="Install Testnizer and create a project." tr="Testnizer'ı kurun ve bir proje oluşturun." /></h2>
      <div class="step-body">
        <div class="dcs">
          <div class="dcs-item anim" style="--i:2"><span class="ic" set:html={ico.target}></span><div><span class="dcs-k">{K.do}</span><p><T en="Download the build for your system from <b>testnizer.com/download</b>, install it and open it. Then create the project this training works in." tr="Sisteminize uygun sürümü <b>testnizer.com/download</b> adresinden indirin, kurun ve açın. Sonra bu eğitimin içinde çalışacağı projeyi oluşturun." /></p></div></div>
          <div class="dcs-item anim" style="--i:3"><span class="ic" set:html={ico.pointer}></span><div><span class="dcs-k">{K.click}</span>
            <ol class="path"><li><span class="ui"><T en="Home" tr="Ana Sayfa" /></span></li><li><span class="ui"><T en="New Project" tr="Yeni Proje" /></span></li><li><span class="ui"><T en="Create New" tr="Yeni Oluştur" /></span></li><li><code>Petstore</code></li><li><span class="ui primary"><T en="Create" tr="Oluştur" /></span></li></ol>
          </div></div>
          <div class="dcs-item anim" style="--i:4"><span class="ic ok" set:html={ico.eye}></span><div><span class="dcs-k">{K.see}</span><p><T en="An empty project. The rail on the left: <b>APIs, Tests, Mocks, History, Tools, Security</b> and <b>Settings</b> at the bottom. No sign-up screen — there is no account." tr="Boş bir proje. Soldaki şerit: <b>API'ler, Testler, Mock'lar, Geçmiş, Araçlar, Güvenlik</b> ve en altta <b>Ayarlar</b>. Kayıt ekranı yok — hesap diye bir şey yok." /></p></div></div>
        </div>
        <div class="col grow anim" style="--i:3;gap:22px;justify-content:center">
          <div class="win" aria-hidden="true">
            <div class="win-bar"><span class="lights"><i></i><i></i><i></i></span><span><T en="New Project" tr="Yeni Proje Oluştur" /></span></div>
            <div class="np-body">
              <div class="np-sources">
                <div class="np-src on"><span class="ic sm" set:html={icons.sparkles}></span><b><T en="Create New" tr="Yeni Oluştur" /></b></div>
                <div class="np-src"><span class="ic sm violet" set:html={icons.gitBranch}></span><b><T en="Clone from Git" tr="Git'ten Klonla" /></b></div>
                <div class="np-src"><span class="ic sm cyan" set:html={icons.hardDrive}></span><b><T en="Open Local" tr="Yerel Aç" /></b></div>
              </div>
              <div class="mcp-field"><label><T en="Project Name *" tr="Proje Adı *" /></label><span>Petstore</span></div>
              <div class="np-actions"><span class="btn primary"><T en="Create" tr="Oluştur" /></span></div>
            </div>
          </div>
          <div class="card tight">
            <span class="kicker"><T en="Where your data lives" tr="Verileriniz nerede durur" /></span>
            <div class="paths">
              <div><b>macOS</b><code>~/Library/Application Support/Testnizer/</code></div>
              <div><b>Windows</b><code>%APPDATA%\Testnizer\</code></div>
              <div><b>Linux</b><code>~/.config/Testnizer/</code></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Slide>

  <!-- 04 · Step 2 · First request -->
  <Slide n={4} deck={deck} label={{ en: 'Step 2 — Send your first request', tr: '2. adım — İlk isteğinizi gönderin' }}>
    <div class="pad">
      <p class="eyebrow anim"><span class="step-no">{stepNo(2)}</span><T en="First request" tr="İlk istek" /></p>
      <h2 class="title sm anim" style="--i:1"><T en="Send your first request." tr="İlk isteğinizi gönderin." /></h2>
      <div class="step-body">
        <div class="dcs">
          <div class="dcs-item anim" style="--i:2"><span class="ic" set:html={ico.target}></span><div><span class="dcs-k">{K.do}</span><p><T en="Open an HTTP tab, call a public echo service, read the answer — then save it with <kbd>Ctrl/Cmd</kbd> <kbd>S</kbd> into a new folder called <b>httpbin</b>." tr="Bir HTTP sekmesi açın, herkese açık bir yankı servisini çağırın, yanıtı okuyun — sonra <kbd>Ctrl/Cmd</kbd> <kbd>S</kbd> ile <b>httpbin</b> adlı yeni bir klasöre kaydedin." /></p></div></div>
          <div class="dcs-item anim" style="--i:3"><span class="ic" set:html={ico.pointer}></span><div><span class="dcs-k">{K.click}</span>
            <ol class="path"><li><span class="ui">+ <T en="New" tr="Yeni" /></span></li><li><span class="ui">HTTP</span></li><li><span class="ui">GET</span></li><li><code>https://httpbin.org/get</code></li><li><span class="ui primary"><T en="Send" tr="Gönder" /></span></li></ol>
          </div></div>
          <div class="dcs-item anim" style="--i:4"><span class="ic ok" set:html={ico.eye}></span><div><span class="dcs-k">{K.see}</span><p><T en="Status, time and size above the response, the JSON body and the headers. The <b>Console</b> (<kbd>Ctrl/Cmd</kbd> <kbd>Alt</kbd> <kbd>C</kbd>) shows the raw request and response." tr="Yanıtın üstünde durum, süre ve boyut; JSON gövdesi ve başlıklar. <b>Konsol</b> (<kbd>Ctrl/Cmd</kbd> <kbd>Alt</kbd> <kbd>C</kbd>) ham istek ve yanıtı gösterir." /></p></div></div>
        </div>
        <div class="win anim step-win" style="--i:3" aria-hidden="true">
          <div class="win-bar"><span class="lights"><i></i><i></i><i></i></span><span class="tabname"><span class="m get">GET</span> httpbin</span></div>
          <div class="reqbar"><span class="method-sel"><span class="m get">GET</span></span><span class="url">https://httpbin.org/get</span><span class="send"><T en="Send" tr="Gönder" /></span></div>
          <div class="tabs"><span><T en="Params" tr="Parametreler" /></span><span><T en="Authorization" tr="Yetkilendirme" /></span><span><T en="Headers" tr="Başlıklar" /></span><span><T en="Body" tr="Gövde" /></span><span><T en="Scripts" tr="Betikler" /></span><span><T en="Tests" tr="Testler" /></span></div>
          <div class="status-row" style="margin-top:8px"><span class="chip ok">200 OK</span><span class="mono">312 ms</span><span class="mono">0.3 KB</span></div>
          <div class="tabs"><span class="on"><T en="Body" tr="Gövde" /></span><span><T en="Cookies" tr="Çerezler" /></span><span><T en="Headers" tr="Başlıklar" /><span class="count">9</span></span><span><T en="Test Results" tr="Test Sonuçları" /></span></div>
          <pre class="code"><span class="p">{'{'}</span>
  <span class="k">"args"</span><span class="p">: {'{}'},</span>
  <span class="k">"headers"</span><span class="p">: {'{'}</span>
    <span class="k">"Accept"</span><span class="p">:</span> <span class="s">"*/*"</span><span class="p">,</span>
    <span class="k">"Host"</span><span class="p">:</span> <span class="s">"httpbin.org"</span><span class="p">,</span>
    <span class="k">"User-Agent"</span><span class="p">:</span> <span class="s">"Testnizer/1.6.0"</span>
  <span class="p">{'},'}</span>
  <span class="k">"url"</span><span class="p">:</span> <span class="s">"https://httpbin.org/get"</span>
<span class="p">{'}'}</span></pre>
        </div>
      </div>
    </div>
  </Slide>

  <!-- 05 · Step 3 · Environments -->
  <Slide n={5} deck={deck} label={{ en: 'Step 3 — Environments and variables', tr: '3. adım — Ortamlar ve değişkenler' }}>
    <div class="pad">
      <p class="eyebrow anim"><span class="step-no">{stepNo(3)}</span><T en="Environments" tr="Ortamlar" /></p>
      <h2 class="title sm anim" style="--i:1"><T en="Put the host and the token in an environment." tr="Host'u ve token'ı bir ortama koyun." /></h2>
      <div class="step-body">
        <div class="dcs">
          <div class="dcs-item anim" style="--i:2"><span class="ic" set:html={ico.target}></span><div><span class="dcs-k">{K.do}</span><p><T en="Create an environment with <code>baseUrl</code> = <code>https://httpbin.org</code> and <code>token</code> = <code>sk-demo-1234</code> (type <b>secret</b>), make it active, and change the URL to <code>{{baseUrl}}/get</code>." tr="<code>baseUrl</code> = <code>https://httpbin.org</code> ve <code>token</code> = <code>sk-demo-1234</code> (tür: <b>gizli</b>) içeren bir ortam oluşturun, aktif yapın ve URL'yi <code>{{baseUrl}}/get</code> olarak değiştirin." /></p></div></div>
          <div class="dcs-item anim" style="--i:3"><span class="ic" set:html={ico.pointer}></span><div><span class="dcs-k">{K.click}</span>
            <ol class="path"><li><T en="environment selector, right end of the tab bar" tr="sekme çubuğunun sağ ucundaki ortam seçici" /></li><li><span class="ui"><T en="Manage Environments" tr="Ortamları Yönet" /></span></li><li><span class="ui"><T en="New Environment" tr="Yeni Ortam" /></span></li><li><span class="ui"><T en="Add Variable" tr="Değişken Ekle" /></span></li><li><span class="ui primary"><T en="Set Active" tr="Aktif Yap" /></span></li></ol>
          </div></div>
          <div class="dcs-item anim" style="--i:4"><span class="ic ok" set:html={ico.eye}></span><div><span class="dcs-k">{K.see}</span><p><T en="The same response as before — the variable is resolved when you send. The secret is masked in History and the Console, encrypted on disk where the OS has a keychain, and left out of Git commits and exports." tr="Öncekiyle aynı yanıt — değişken gönderirken çözülür. Gizli değer Geçmiş'te ve Konsol'da maskelenir, işletim sisteminde anahtarlık varsa diskte şifrelenir; Git commit'lerine ve dışa aktarımlara girmez." /></p></div></div>
        </div>
        <div class="win anim step-win" style="--i:3" aria-hidden="true">
          <div class="win-bar"><span class="lights"><i></i><i></i><i></i></span><span><T en="Manage Environments" tr="Ortamları Yönet" /></span></div>
          <div class="env-split">
            <ul class="tree env-list">
              <li class="sel"><span class="pill-dot"></span>staging</li>
              <li><T en="Globals" tr="Globaller" /></li>
            </ul>
            <div class="env-main">
              <div class="env-head"><b>staging</b><span class="tag ok"><T en="Active" tr="Aktif" /></span></div>
              <div class="kv kv-box" style="--kv-cols:100px 92px 1fr 1fr">
                <div class="h"><span><T en="Variable" tr="Değişken" /></span><span><T en="Type" tr="Tür" /></span><span><T en="Initial Value" tr="Başlangıç Değeri" /></span><span><T en="Current Value" tr="Geçerli Değer" /></span></div>
                <div><span>baseUrl</span><span class="soft">default</span><span>https://httpbin.org</span><span>https://httpbin.org</span></div>
                <div><span>token</span><span class="tag warn" style="justify-self:start"><T en="secret" tr="gizli" /></span><span class="masked">••••••••••</span><span class="masked">••••••••••</span></div>
              </div>
              <div class="reqbar" style="padding:22px 0 0"><span class="method-sel"><span class="m get">GET</span></span><span class="url"><span class="var">{'{{baseUrl}}'}</span>/get</span><span class="send"><T en="Send" tr="Gönder" /></span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Slide>

  <!-- 06 · Step 4 · Auth -->
  <Slide n={6} deck={deck} label={{ en: 'Step 4 — Authorization', tr: '4. adım — Yetkilendirme' }}>
    <div class="pad">
      <p class="eyebrow anim"><span class="step-no">{stepNo(4)}</span><T en="Authorization" tr="Yetkilendirme" /></p>
      <h2 class="title sm anim" style="--i:1"><T en="Send a bearer token — once, for the whole folder." tr="Bearer token gönderin — bir kez, bütün klasör için." /></h2>
      <div class="step-body">
        <div class="dcs">
          <div class="dcs-item anim" style="--i:2"><span class="ic" set:html={ico.target}></span><div><span class="dcs-k">{K.do}</span><p><T en="Set the token on the <b>httpbin</b> folder, then add a request to <code>{{baseUrl}}/bearer</code> in that folder whose auth is <b>Inherit from parent</b>." tr="Token'ı <b>httpbin</b> klasörüne verin; sonra aynı klasöre, yetkilendirmesi <b>Üstten miras al</b> olan <code>{{baseUrl}}/bearer</code> isteğini ekleyin." /></p></div></div>
          <div class="dcs-item anim" style="--i:3"><span class="ic" set:html={ico.pointer}></span><div><span class="dcs-k">{K.click}</span>
            <ol class="path"><li><T en="right-click the folder" tr="klasöre sağ tık" /></li><li><span class="ui"><T en="Settings" tr="Ayarlar" /></span></li><li><span class="ui"><T en="Authorization" tr="Yetkilendirme" /></span></li><li><span class="ui">Bearer Token</span></li><li><code>{'{{token}}'}</code></li></ol>
          </div></div>
