      <div class="content" style="gap:56px;align-items:stretch">
        <div class="keys anim" style="--i:2">
          {shortcuts.map((s) => (
            <div><span class="keys-k">{s.k.map((k) => <kbd>{k}</kbd>)}</span><span>{isTr ? s.tr : s.en}</span></div>
          ))}
        </div>
        <div class="col grow" style="gap:18px;justify-content:center">
          <div class="card tight anim" style="--i:3"><h4><T en="Paste a cURL into the URL bar" tr="URL çubuğuna bir cURL yapıştırın" /></h4><p><T en="It becomes a full request — method, headers, body, auth. One Undo puts the text back." tr="Tam bir isteğe dönüşür — metot, başlıklar, gövde, auth. Tek bir Geri Al metni geri getirir." /></p></div>
          <div class="card tight anim" style="--i:4"><h4><T en="Generate Code — 36 variants" tr="Kod Oluştur — 36 varyant" /></h4><p><T en="Turn the open request into code for your language. Secret variables stay as <code>{{name}}</code> unless you choose to include them." tr="Açık isteği kendi dilinizde koda çevirin. Gizli değişkenler, siz dahil etmeyi seçmedikçe <code>{{ad}}</code> olarak kalır." /></p></div>
          <div class="card tight anim" style="--i:5"><h4><T en="118 dynamic variables" tr="118 dinamik değişken" /></h4><p><T en="<code>{{$randomEmail}}</code>, <code>{{$guid}}</code>, <code>{{$timestamp}}</code> … — the same names as Postman." tr="<code>{{$randomEmail}}</code>, <code>{{$guid}}</code>, <code>{{$timestamp}}</code> … — Postman'deki adlarla aynı." /></p></div>
        </div>
      </div>
    </div>
  </Slide>

