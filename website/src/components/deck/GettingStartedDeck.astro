          </div>
          <div class="commit-btns"><span class="btn"><T en="Commit" tr="Commit et" /></span><span class="btn primary"><T en="Commit and push" tr="Commit et ve gönder" /></span></div>
        </div>
      </div>
    </div>
  </Slide>

  <!-- 16 · Step 14 · Shortcuts -->
  <Slide n={16} deck={deck} label={{ en: 'Step 14 — Shortcuts and tips', tr: '14. adım — Kısayollar ve ipuçları' }}>
