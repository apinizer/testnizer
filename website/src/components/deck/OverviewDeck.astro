---
/**
 * Testnizer product overview deck. Every string is written once with its
 * Turkish twin (<T en tr>); facts come from docs/release-notes/v1.6.0.md,
 * src/content/docs and the site pages — no customer counts, benchmarks or
 * rival comparisons. Mock panels are sketches of the app with sample data
 * (example.com, the Petstore API); they are marked as samples where a number
 * could be mistaken for a measurement.
 */
import DeckLayout from './DeckLayout.astro'
import Slide from './Slide.astro'
import T from './T.astro'
import { icons } from '../icons'
import { langOf } from '../../lib/presentations'

const deck = 'testnizer-overview'
const isTr = langOf(Astro.url.pathname) === 'tr'
const p = (href: string): string => (isTr ? `/tr${href}` : href)

const protocols = [
  { icon: icons.globe, name: 'HTTP / REST', en: 'Every body mode, path variables, cookies, mTLS, proxy; paste a cURL into the URL bar', tr: 'Tüm gövde modları, path değişkenleri, çerezler, mTLS, proxy; URL çubuğuna cURL yapıştırın' },
  { icon: icons.fileCode, name: 'SOAP / WSDL', en: 'WSDL import, SOAP 1.1 + 1.2, WS-Security on Send and in the Runner', tr: "WSDL içe aktarma, SOAP 1.1 + 1.2, Send'de ve Runner'da WS-Security" },
  { icon: icons.network, name: 'GraphQL', en: 'Queries, mutations, schema explorer, subscriptions over WebSocket', tr: 'Sorgular, mutasyonlar, şema gezgini, WebSocket üzerinden abonelikler' },
  { icon: icons.cpu, name: 'gRPC', en: '.proto import, all four streaming modes, metadata', tr: '.proto içe aktarma, dört akış modu, meta veri' },
  { icon: icons.radio, name: 'WebSocket', en: 'Text, JSON, XML, Base64, hex; saved messages, searchable log', tr: 'Metin, JSON, XML, Base64, hex; kayıtlı mesajlar, aranabilir günlük' },
  { icon: icons.arrowsLeftRight, name: 'Socket.IO', en: 'Client v2, v3 or v4, namespaces, acknowledgements', tr: 'v2, v3 veya v4 istemci, namespace, onaylar (ack)' },
  { icon: icons.repeat, name: 'MQTT', en: 'MQTT 3.1.1 and 5.0 — QoS, retain, last will, TLS', tr: 'MQTT 3.1.1 ve 5.0 — QoS, retain, last will, TLS' },
  { icon: icons.zap, name: 'Server-Sent Events', en: 'Long-lived streams, custom headers, Last-Event-ID resume', tr: 'Uzun ömürlü akışlar, özel başlıklar, Last-Event-ID ile devam' },
  { icon: icons.plug, name: 'MCP', en: 'Streamable HTTP, SSE and stdio; tools, resources, prompts', tr: "Streamable HTTP, SSE ve stdio; araçlar, kaynaklar, prompt'lar" },
  { icon: icons.bot, name: 'AI Chat', en: '14 providers plus a custom URL, streaming, MCP tools', tr: '14 sağlayıcı artı özel URL, akışlı yanıt, MCP araçları' },
]

const scanCats = [
  { en: 'Transport security', tr: 'Taşıma güvenliği', v: 100, c: '' },
  { en: 'Authentication & authorization', tr: 'Kimlik doğrulama ve yetkilendirme', v: 94, c: 'warn' },
  { en: 'Protocol conformance', tr: 'Protokol uyumu', v: 100, c: '' },
  { en: 'Prompt injection & tool poisoning', tr: 'İstem enjeksiyonu ve araç zehirleme', v: 89, c: 'warn' },
  { en: 'Information disclosure', tr: 'Bilgi ifşası', v: 97, c: 'warn' },
  { en: 'CORS', tr: 'CORS', v: 100, c: '' },
  { en: 'Security headers', tr: 'Güvenlik başlıkları', v: 77, c: 'bad' },
  { en: 'Rate limiting', tr: 'Hız sınırlama', v: 0, c: 'skip' },
]

const tools = [
  { icon: icons.key, name: 'Keystore Studio', en: 'JKS and PKCS#12 without keytool: open, create, convert, inspect certificates', tr: "keytool'suz JKS ve PKCS#12: açın, oluşturun, dönüştürün, sertifikaları inceleyin" },
  { icon: icons.fingerprint, name: 'JWT / JOSE', en: 'Decode, sign, verify, encrypt and decrypt — also as pm.jose in scripts', tr: "Çözün, imzalayın, doğrulayın, şifreleyin — script'lerde pm.jose olarak da" },
  { icon: icons.hash, name: 'JWK / JWKS', en: 'PEM ⇄ JWK, RFC 7638 thumbprints, a JWKS served by the mock server', tr: 'PEM ⇄ JWK, RFC 7638 parmak izleri, mock sunucudan servis edilen JWKS' },
  { icon: icons.fileCode, name: 'SAML 2.0', en: 'Build, sign and validate — signature wrapping is rejected', tr: 'Oluşturun, imzalayın, doğrulayın — imza sarmalama reddedilir' },
  { icon: icons.fileText, name: 'WS-Security', en: 'UsernameToken, Timestamp, XML signature and encryption on the SOAP request', tr: 'SOAP isteğinde UsernameToken, Timestamp, XML imza ve şifreleme' },
  { icon: icons.search, name: 'TLS Inspector', en: 'What a live endpoint presents: chain, protocol, ciphers', tr: 'Canlı bir uç noktanın sunduğu: zincir, protokol, şifre takımları' },
  { icon: icons.lock, name: isTr ? 'mTLS ve sertifikalar' : 'mTLS & certificates', en: 'Client certificates per host, from PEM, PFX or a keystore entry', tr: 'Host başına istemci sertifikası; PEM, PFX ya da keystore girdisinden' },
  { icon: icons.calculator, name: isTr ? 'Parola, OTP ve QR' : 'Passwords, OTP, QR', en: 'Plus JSONPath, XPath, XSLT, Jolt, diff, hashes and encoders', tr: 'Ayrıca JSONPath, XPath, XSLT, Jolt, fark, hash ve kodlayıcılar' },
]
---

<DeckLayout slug={deck}>

  <!-- 01 · Cover -->
  <Slide n={1} deck={deck} bare label={{ en: 'Cover', tr: 'Kapak' }} class="cover">
    <div class="glow-bg"></div>
    <div class="dots-bg"></div>
    <div class="pad">
      <div class="cover-top anim">
        <span class="wordmark"><i class="logo-img lg"></i>Testnizer</span>
        <span class="cover-meta"><T en="Product overview · v1.6.0" tr="Ürün tanıtımı · v1.6.0" /></span>
      </div>
      <div class="cover-main">
        <div class="cover-copy">
          <h1 class="cover-title anim" style="--i:1"><T en="The offline API and AI client that also does <span class='grad'>your security work.</span>" tr="Çevrimdışı API ve yapay zeka istemcisi, <span class='grad'>güvenlik işinizi de yapar.</span>" /></h1>
          <p class="lead anim" style="--i:2"><T en="Test APIs, MCP servers and LLMs, mock all of them locally, and do the cryptography on your own machine — <b>free, no account, no telemetry.</b>" tr="API'leri, MCP sunucularını ve LLM'leri test edin, hepsini yerelde mock'layın, kriptografiyi kendi makinenizde yapın — <b>ücretsiz, hesap yok, telemetri yok.</b>" /></p>
        </div>
        <div class="cover-stack" aria-hidden="true">
          <div class="win cs1 anim" style="--i:3">
            <div class="reqbar"><span class="method-sel"><span class="m get">GET</span></span><span class="url"><span class="var">{'{{baseUrl}}'}</span>/pet/42</span><span class="send"><T en="Send" tr="Gönder" /></span></div>
            <div class="status-row"><span class="chip ok">200 OK</span><span>184 ms</span><span>0.4 KB</span><span class="tag ok" style="margin-left:auto">3/3 <T en="tests passed" tr="test geçti" /></span></div>
          </div>
          <div class="win cs2 anim" style="--i:4">
            <div class="cs-row"><span class="ic sm violet" set:html={icons.plug}></span><div><b>tools/call</b> · <span class="mono">echo</span><small>MCP 2026-07-28 · Streamable HTTP</small></div><span class="chip ok">OK</span></div>
          </div>
          <div class="win cs3 anim" style="--i:5">
            <div class="cs-row"><span class="grade mini">A</span><div><b><T en="MCP security scan" tr="MCP güvenlik taraması" /></b><small><T en="sample report · 92 / 100" tr="örnek rapor · 92 / 100" /></small></div></div>
          </div>
        </div>
      </div>
      <div class="cover-foot anim" style="--i:6">
        <div class="pills">
          {['HTTP', 'SOAP', 'GraphQL', 'gRPC', 'WebSocket', 'Socket.IO', 'MQTT', 'SSE', 'MCP', 'AI Chat'].map((x) => <span class="pill mono">{x}</span>)}
        </div>
        <span class="cover-os">macOS · Windows · Linux</span>
      </div>
    </div>
  </Slide>

  <!-- 02 · What it is, who it is for -->
  <Slide n={2} deck={deck} label={{ en: 'What Testnizer is', tr: 'Testnizer nedir' }}>
    <div class="pad">
      <p class="eyebrow anim"><T en="What it is" tr="Nedir" /></p>
      <h2 class="title anim" style="--i:1"><T en="One desktop app for <span class='grad'>the whole API workbench.</span>" tr="Tüm API tezgâhı için <span class='grad'>tek bir masaüstü uygulaması.</span>" /></h2>
      <p class="lead anim" style="--i:2"><T en="Testnizer is a free desktop client for macOS, Windows and Linux. It runs entirely on your computer: nothing to sign up for, no server to install, no cloud in between." tr="Testnizer; macOS, Windows ve Linux için ücretsiz bir masaüstü istemcisidir. Tamamen bilgisayarınızda çalışır: kayıt olunacak bir şey yok, kurulacak sunucu yok, arada bulut yok." /></p>
      <div class="content">
        <div class="grid g3 pillars">
          <div class="card anim" style="--i:2">
            <span class="ic" set:html={icons.globe}></span>
            <span class="kicker pillar-k"><T en="Test" tr="Test edin" /></span>
            <h3><T en="APIs, MCP servers and LLMs" tr="API'ler, MCP sunucuları ve LLM'ler" /></h3>
            <p><T en="REST, SOAP, GraphQL, gRPC and real-time protocols, an MCP client, and AI Chat across 14 providers — with scripts, tests and the Runner." tr="REST, SOAP, GraphQL, gRPC ve gerçek zamanlı protokoller, bir MCP istemcisi ve 14 sağlayıcıyla AI Chat — script'ler, testler ve Runner ile." /></p>
          </div>
          <div class="card anim" style="--i:3">
            <span class="ic cyan" set:html={icons.server}></span>
            <span class="kicker pillar-k"><T en="Mock" tr="Mock'layın" /></span>
            <h3><T en="Every side of the conversation" tr="Konuşmanın her iki ucu" /></h3>
            <p><T en="HTTP, SSE, AI (OpenAI and Anthropic APIs) and MCP mock servers on <b>127.0.0.1</b>, with the latency and failures you choose." tr="<b>127.0.0.1</b> üzerinde HTTP, SSE, AI (OpenAI ve Anthropic API'leri) ve MCP mock sunucuları; gecikme ve hatalar sizin seçiminiz." /></p>
          </div>
          <div class="card anim" style="--i:4">
            <span class="ic ok" set:html={icons.shieldCheck}></span>
            <span class="kicker pillar-k"><T en="Secure" tr="Güvenli kılın" /></span>
            <h3><T en="The cryptography, on your machine" tr="Kriptografi, kendi makinenizde" /></h3>
            <p><T en="Keystores, mTLS, JWT / JOSE, JWK, SAML, WS-Security, a TLS inspector and an MCP security scan — the private key never leaves the app." tr="Keystore'lar, mTLS, JWT / JOSE, JWK, SAML, WS-Security, TLS denetçisi ve MCP güvenlik taraması — özel anahtar uygulamadan çıkmaz." /></p>
          </div>
        </div>
      </div>
      <div class="row who anim" style="--i:5">
        <div class="who-item"><span class="ic sm" set:html={icons.building}></span><p><T en="<b>Built for regulated teams</b> — banking, government, insurance and healthcare, where production credentials must never leave the machine." tr="<b>Düzenlemeye tabi ekipler için</b> — üretim kimlik bilgilerinin makineden asla çıkmaması gereken bankacılık, kamu, sigorta ve sağlık." /></p></div>
        <div class="who-item"><span class="ic sm violet" set:html={icons.terminal}></span><p><T en="<b>And for every developer</b> — free, no sign-up, and your Postman collections and scripts come with you." tr="<b>Ve her geliştirici için</b> — ücretsiz, kayıt yok; Postman koleksiyonlarınız ve script'leriniz sizinle gelir." /></p></div>
      </div>
    </div>
  </Slide>

  <!-- 03 · Why offline -->
  <Slide n={3} deck={deck} label={{ en: 'Why offline', tr: 'Neden çevrimdışı' }}>
    <div class="pad">
      <p class="eyebrow anim"><T en="Why offline" tr="Neden çevrimdışı" /></p>
      <h2 class="title anim" style="--i:1"><T en="Requests go to your targets. <span class='grad'>Nothing goes to us.</span>" tr="İstekler sizin hedeflerinize gider. <span class='grad'>Bize hiçbir şey gelmez.</span>" /></h2>
      <div class="content" style="gap:56px">
        <div class="diagram offline-dia anim" style="--i:2" aria-hidden="true">
          <div class="machine"><span class="machine-label"><T en="Your computer" tr="Sizin bilgisayarınız" /></span></div>
          <svg class="wires" viewBox="0 0 980 560" preserveAspectRatio="none">
            <path d="M300 168 L380 250" class="live dash" />
            <path d="M300 392 L380 310" class="live dash" />
            <path d="M640 280 C 700 280, 700 110, 760 110" class="ok" />
            <path d="M640 280 L760 280" class="ok" />
            <path d="M640 280 C 700 280, 700 450, 760 450" class="ok" />
          </svg>
          <div class="node" style="left:34px;top:122px;width:266px"><span class="ic sm" set:html={icons.globe}></span><span><T en="Interface" tr="Arayüz" /><small>CSP connect-src 'self'</small></span></div>
          <div class="node" style="left:34px;top:346px;width:266px"><span class="ic sm" set:html={icons.hardDrive}></span><span><T en="Local database" tr="Yerel veritabanı" /><small>SQLite · <T en="on your disk" tr="diskinizde" /></small></span></div>
          <div class="node core" style="left:380px;top:206px;width:260px;height:148px"><span class="ic" set:html={icons.cpu}></span><span><T en="App core" tr="Uygulama çekirdeği" /><small><T en="every network call" tr="tüm ağ çağrıları" /></small></span></div>
          <div class="node" style="left:760px;top:74px;width:220px"><span><T en="Your APIs" tr="API'leriniz" /></span></div>
          <div class="node" style="left:760px;top:244px;width:220px"><span><T en="Your MCP servers" tr="MCP sunucularınız" /></span></div>
          <div class="node" style="left:760px;top:414px;width:220px"><span><T en="Your LLM provider" tr="LLM sağlayıcınız" /></span></div>
        </div>
        <div class="col grow" style="gap:18px">
          <div class="nope anim" style="--i:3"><span class="ic bad sm" set:html={icons.x}></span><span><T en="No account, no cloud login, no sync" tr="Hesap yok, bulut girişi yok, eşitleme yok" /></span></div>
          <div class="nope anim" style="--i:4"><span class="ic bad sm" set:html={icons.x}></span><span><T en="No telemetry — there is no analytics endpoint" tr="Telemetri yok — bir analitik uç noktası hiç yok" /></span></div>
          <div class="nope anim" style="--i:5"><span class="ic bad sm" set:html={icons.x}></span><span><T en="No background traffic from the interface" tr="Arayüzden arka planda trafik yok" /></span></div>
          <p class="body-copy anim" style="--i:6;margin-top:10px"><T en="The interface cannot open a network connection of its own: every request runs in the app core and goes only where you send it. Workspaces, history, certificates and secrets live in one local database. The only request of its own is the update check, which you can turn off — air-gapped networks are supported." tr="Arayüz kendi başına ağ bağlantısı açamaz: her istek uygulama çekirdeğinde çalışır ve yalnız sizin gönderdiğiniz yere gider. Çalışma alanları, geçmiş, sertifikalar ve sırlar tek bir yerel veritabanında durur. Kendi yaptığı tek istek kapatılabilen güncelleme kontrolüdür — hava boşluklu ağlar desteklenir." /></p>
        </div>
      </div>
    </div>
  </Slide>

  <!-- 04 · Protocols -->
  <Slide n={4} deck={deck} label={{ en: 'Protocols', tr: 'Protokoller' }}>
    <div class="pad">
      <p class="eyebrow anim"><T en="One client, every protocol" tr="Tek istemci, tüm protokoller" /></p>
      <h2 class="title anim" style="--i:1"><T en="Eight API protocols, <span class='grad'>plus MCP and AI Chat.</span>" tr="Sekiz API protokolü, <span class='grad'>üstüne MCP ve AI Chat.</span>" /></h2>
      <p class="lead anim" style="--i:2"><T en="Each one has its own editor, not a generic HTTP form — and they all share the project's environments and <code>{{variables}}</code> and save with <kbd>Ctrl/Cmd</kbd> <kbd>S</kbd>." tr="Her birinin kendi editörü var, genel bir HTTP formu değil — ve hepsi projenin ortamlarını ve <code>{{değişkenlerini}}</code> paylaşır, <kbd>Ctrl/Cmd</kbd> <kbd>S</kbd> ile kaydedilir." /></p>
      <div class="content">
        <div class="grid g5 proto-grid">
          {protocols.map((pr, i) => (
            <div class:list={['card tight anim', i >= 8 && 'hl']} style={`--i:${3 + i}`}>
              <span class:list={['ic sm', i >= 8 && 'violet']} set:html={pr.icon}></span>
              <h4>{pr.name}</h4>
              <p>{isTr ? pr.tr : pr.en}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Slide>

  <!-- 05 · MCP client -->
  <Slide n={5} deck={deck} label={{ en: 'MCP client', tr: 'MCP istemcisi' }}>
    <div class="pad">
      <div class="row grow" style="gap:60px;min-height:0">
        <div class="col" style="width:720px;flex:none;gap:0">
          <p class="eyebrow anim"><T en="AI &amp; MCP · the client" tr="Yapay zeka &amp; MCP · istemci" /></p>
          <h2 class="title sm anim" style="--i:1"><T en="Everything an MCP server offers, <span class='grad'>in one tab.</span>" tr="Bir MCP sunucusunun sunduğu her şey, <span class='grad'>tek sekmede.</span>" /></h2>
          <ul class="checks anim" style="--i:2;margin-top:34px">
            <li><T en="<b>Streamable HTTP, legacy SSE or stdio</b> — for stdio, Testnizer starts the local server" tr="<b>Streamable HTTP, eski SSE ya da stdio</b> — stdio'da yerel sunucuyu Testnizer başlatır" /></li>
            <li><T en="Protocol <b>2024-10-07 to 2026-07-28</b>: Auto, Legacy or a pinned version" tr="<b>2024-10-07'den 2026-07-28'e</b> protokol: Otomatik, Legacy ya da sabit sürüm" /></li>
            <li><T en="Tool arguments as a <b>form built from the JSON Schema</b>; resources, prompts, notifications" tr="Araç argümanları <b>JSON Schema'dan üretilen formla</b>; kaynaklar, prompt'lar, bildirimler" /></li>
            <li><T en="The <b>raw JSON-RPC frames</b>, handshake included" tr="El sıkışma dahil <b>ham JSON-RPC çerçeveleri</b>" /></li>
            <li><T en="An <b>OAuth 2.1 debugger</b>: metadata, client registration, PKCE, sign-in and token exchange, step by step — tokens stay in the app core" tr="<b>OAuth 2.1 hata ayıklayıcı</b>: metadata, istemci kaydı, PKCE, oturum açma ve token değişimi adım adım — token'lar uygulama çekirdeğinde kalır" /></li>
            <li><T en="Save calls with tests and scripts (<code>pm.mcp</code>) and run them in the <b>Runner</b>, a Test Suite or a schedule" tr="Çağrıları testler ve script'lerle (<code>pm.mcp</code>) kaydedin; <b>Runner</b>'da, bir Test Paketinde ya da zamanlanmış görevde çalıştırın" /></li>
          </ul>
        </div>
        <div class="win grow anim mcp-win" style="--i:3" aria-hidden="true">
          <div class="win-bar"><span class="lights"><i></i><i></i><i></i></span><span class="tabname"><span class="m mcp">MCP</span> Petstore MCP</span></div>
          <div class="reqbar">
            <span class="method-sel">Streamable HTTP</span>
            <span class="method-sel"><T en="Auto" tr="Otomatik" /></span>
            <span class="url">https://mcp.example.com/mcp</span>
            <span class="send ghost"><T en="Disconnect" tr="Bağlantıyı Kes" /></span>
          </div>
          <div class="mcp-meta"><span class="pill accent mini-pill"><span class="dot"></span>MCP 2026-07-28</span><span>petstore-mcp 2.1.0</span></div>
          <div class="mcp-split">
            <div class="mcp-list">
              <div class="tabs"><span class="on"><T en="Tools" tr="Araçlar" /><span class="count">4</span></span><span><T en="Resources" tr="Kaynaklar" /></span><span><T en="Prompts" tr="İstemler" /></span></div>
              <ul class="tree tool-list">
                <li class="sel"><span class="m mcp">ƒ</span>find_pet</li>
                <li><span class="m mcp">ƒ</span>list_pets</li>
                <li><span class="m mcp">ƒ</span>place_order</li>
                <li><span class="m mcp">ƒ</span>get_inventory</li>
              </ul>
            </div>
            <div class="mcp-explorer">
              <div class="mcp-tool"><b>find_pet</b><span class="tag accent"><T en="read-only" tr="salt okunur" /></span></div>
              <div class="mcp-field"><label>petId <em>integer</em></label><span>42</span></div>
              <div class="mcp-actions"><span class="btn primary"><T en="Run" tr="Çalıştır" /></span><span class="metrics"><span class="ok">OK</span><span>212 ms</span><span>1.2 KB</span></span></div>
              <pre class="code"><span class="p">{'{'}</span> <span class="k">"id"</span><span class="p">:</span> <span class="n">42</span><span class="p">,</span> <span class="k">"name"</span><span class="p">:</span> <span class="s">"Rex"</span><span class="p">,</span> <span class="k">"status"</span><span class="p">:</span> <span class="s">"available"</span> <span class="p">{'}'}</span></pre>
            </div>
          </div>
          <div class="mcp-frames">
            <div class="tabs"><span><T en="Notifications" tr="Bildirimler" /></span><span class="on"><T en="Frames" tr="Çerçeveler" /></span></div>
            <div class="log frames">
              <div><span class="t">10:42:07</span><span class="dir out">→</span><span>tools/call <span class="p">{'{'}"name":"find_pet","arguments":{'{'}"petId":42{'}}'}</span></span></div>
              <div><span class="t">10:42:07</span><span class="dir in">←</span><span>result <span class="p">{'{'}"content":[{'{'}"type":"text",…{'}'}]{'}'}</span></span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Slide>

  <!-- 06 · Security scan -->
  <Slide n={6} deck={deck} label={{ en: 'MCP security scan', tr: 'MCP güvenlik taraması' }}>
    <div class="pad">
      <p class="eyebrow anim"><T en="AI &amp; MCP · security scan" tr="Yapay zeka &amp; MCP · güvenlik taraması" /></p>
      <h2 class="title anim" style="--i:1"><T en="An A–F report on an MCP server, <span class='grad'>every finding with its evidence.</span>" tr="Bir MCP sunucusu için A–F notlu rapor, <span class='grad'>her bulgu kanıtıyla.</span>" /></h2>
      <div class="content" style="gap:40px">
        <div class="win anim scan-win" style="--i:2" aria-hidden="true">
          <div class="win-bar"><span class="lights"><i></i><i></i><i></i></span><span><T en="Security · sample report" tr="Güvenlik · örnek rapor" /></span><span class="right"><span class="btn"><T en="Save HTML report…" tr="HTML raporu kaydet…" /></span></span></div>
          <div class="scan-head">
            <span class="grade b">B</span>
            <div class="col" style="gap:12px;flex:1;min-width:0">
              <div class="scan-score"><b>86</b><span>/ 100</span><span class="tag violet">MCP 2026-07-28</span></div>
