---
import BaseLayout from '../layouts/BaseLayout.astro'
import GuaranteeCard from '../components/GuaranteeCard.astro'
import StatBadge from '../components/StatBadge.astro'
import ProductHuntBadge from '../components/ProductHuntBadge.astro'
import { icons } from '../components/icons'
import { fetchLatestRelease, fetchRepoStats, formatCount } from '../lib/latest-release'

const release = await fetchLatestRelease()
const stats = await fetchRepoStats()
const releasesUrl = release.htmlUrl.replace(/\/tag\/.*$/, '').replace(/\/latest$/, '')

const guarantees = [
  {
    icon: icons.shieldOff,
    title: '100% Offline',
    body: 'Air-gapped networks supported. The app sends API requests only to the targets you configure — never to a vendor server. No cloud login, no account, no telemetry.',
  },
  {
    icon: icons.hardDrive,
    title: 'Local Storage Only',
    body: 'Workspaces, projects, environments, history, certificates and secrets live in a single SQLite database on your disk. Move it, back it up, delete it — your call.',
  },
  {
    icon: icons.gitBranch,
    title: 'Internal Git & Local DB',
    body: 'Tests live next to your code in your existing Git repo. Built-in simple-git integration means collections branch and review through your normal PR pipeline.',
  },
  {
    icon: icons.lock,
    title: 'Zero Data Leakage',
    body: 'The renderer has CSP connect-src self — physically incapable of reaching the public internet. Every API call goes through an audited main-process IPC handler you control.',
  },
]

// The four things the hero used to say in two long paragraphs, as scannable
// cards. Each one links to the page that backs it up.
const pillars = [
  {
    icon: icons.globe,
    title: 'API protocols',
    body: 'HTTP · SOAP · GraphQL · gRPC · WebSocket · Socket.IO · MQTT · SSE',
    href: '/features',
  },
  {
    icon: icons.sparkles,
    title: 'AI & MCP',
    body: 'MCP client · MCP security scan · AI Chat that can call MCP tools',
    href: '/ai-mcp',
  },
  {
    icon: icons.server,
    title: 'Mock servers',
    body: 'HTTP · SSE · AI (LLM) · MCP mocks, on 127.0.0.1 by default',
    href: '/docs/mock-server',
  },
  {
    icon: icons.key,
    title: 'Security toolbox',
    body: 'Keystores · mTLS · JWT / JOSE · JWK / JWKS · WS-Security · SAML · TLS — the private key never leaves the app',
    href: '/security-tools',
  },
]

const newIn160 = [
  {
    icon: icons.plug,
    title: 'A full MCP client',
    body: 'Streamable HTTP, legacy SSE and stdio. Protocol 2024-10-07 through 2026-07-28 — Auto, Legacy or a pinned version. Tools, resources, prompts, notifications and the raw JSON-RPC frames, plus an OAuth 2.1 debugger.',
  },
  {
    icon: icons.shieldCheck,
    title: 'MCP security scan',
    body: 'A graded A–F report across transport, authentication, protocol behaviour, prompt-injection heuristics, information disclosure, CORS, security headers and an opt-in rate-limit probe. Exports as one HTML file.',
  },
  {
    icon: icons.bot,
    title: 'AI Chat with MCP tools',
    body: 'The assistant can call tools from your MCP servers — and every call asks for your approval by default. Each reply shows time to first token, duration and token usage. Conversations stay on this machine.',
  },
  {
    icon: icons.activity,
    title: 'Mock SSE, LLM and MCP servers',
    body: 'Stream events, answer the OpenAI and Anthropic APIs, or serve MCP tools — with latency and errors you choose. Develop an agent without a provider account, and without spending a token.',
  },
]

const protocols = [
  { icon: icons.globe, name: 'HTTP / REST', body: 'Params, path variables, headers, every body mode, cookies, mTLS, proxy, redirects, scripts and assertions. Paste a cURL command into the URL bar.' },
  { icon: icons.fileCode, name: 'SOAP / WSDL', body: 'WSDL import, SOAP 1.1 + 1.2, manual envelopes, and WS-Security applied on Send and in the Runner.' },
  { icon: icons.cpu, name: 'gRPC', body: '.proto import, all four streaming modes, metadata, JSON skeleton from message fields.' },
  { icon: icons.network, name: 'GraphQL', body: 'Queries, mutations, schema explorer, and subscriptions over WebSocket (graphql-transport-ws, with graphql-ws fallback).' },
  { icon: icons.radio, name: 'WebSocket', body: 'Text, JSON, XML, HTML, Base64 and hex messages, saved messages, a searchable log with filters.' },
  { icon: icons.arrowsLeftRight, name: 'Socket.IO', body: 'Client v2, v3 or v4, namespaces, auth, acknowledgements, several arguments per emit, per-event listen switches.' },
  { icon: icons.repeat, name: 'MQTT', body: 'MQTT 3.1.1 and 5.0 — QoS, retain, last will, TLS with your certificates, MQTT 5 properties, saved messages.' },
  { icon: icons.zap, name: 'Server-Sent Events', body: 'Long-lived streams with custom headers, Last-Event-ID resume and an event-type filter.' },
  { icon: icons.plug, name: 'MCP', body: 'Streamable HTTP, SSE and stdio. Tools, resources, prompts, raw JSON-RPC frames, OAuth 2.1 and a security scan.' },
  { icon: icons.bot, name: 'AI Chat', body: '14 providers plus a Custom URL, streaming, MCP tools with approval. Requests go directly to the provider you configure.' },
]

const migrationFormats = [
  'OpenAPI 3.x',
  'Swagger 2.0',
  'Postman v1 / v2.0 / v2.1',
  'Postman v3 (JSON or Native Git folder)',
  'Postman .zip & data dump',
  'Insomnia v4 / v5',
  'cURL (bash, CMD, PowerShell)',
  'WSDL',
  '.proto',
  'RAML 1.0',
  'SoapUI / ReadyAPI',
  'HAR',
]

const tools = [
  'JWT debugger',
  'WS-Security workbench',
  'AES / RSA encrypt / decrypt',
  'XML Signature & Encryption',
  'JSON / XML formatters',
  'Base64 / URL / Hex encoders',
  'JSONPath / XPath / XSLT / Jolt',
  'Text diff',
]
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero-glow relative overflow-hidden border-b border-border">
    <div class="dot-grid absolute inset-0"></div>
    <!-- The fold is budgeted: pill → Product Hunt badge must fit under the
         sticky nav at 1366×768, so the vertical rhythm here is deliberately
         tighter than the sections below. The capability pillars follow the
         CTA block instead of a paragraph above it. -->
    <div class="relative mx-auto max-w-6xl px-6 pt-10 pb-12 text-center md:pt-14 md:pb-14">
      <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-border bg-bg-soft px-3 py-1 text-xs font-medium text-text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
        {release.tag} — free forever · a project by Apinizer
      </div>

      <h1 class="mx-auto max-w-5xl text-balance text-4xl font-semibold tracking-tight text-text md:text-5xl md:leading-[1.1] lg:text-6xl">
        The offline API and AI client that also does
        <span class="text-gradient">your security work.</span>
      </h1>

      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-text-muted">
        Test APIs, MCP servers and LLMs, mock all of them locally, and do the cryptography on your own machine — free, no account, no telemetry.
      </p>

      <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/download"
          class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-medium text-white shadow-sm transition-colors hover:bg-accent-hover"
        >
          <Fragment set:html={icons.download} />
          Download for macOS, Windows, Linux
        </a>
        <a
          href="/docs/getting-started"
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-bg px-5 py-3 text-sm font-medium text-text transition-colors hover:bg-bg-muted"
        >
          Read the docs
          <Fragment set:html={icons.arrowRight} />
        </a>
      </div>

      <p class="mt-4 text-xs text-text-soft">
        macOS (arm64 / x64) · Windows (x64 / arm64) · Linux (deb / AppImage)
      </p>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        <StatBadge label="latest release" value={release.tag} href={releasesUrl} />
        {stats && stats.downloads > 0 && <StatBadge label="downloads" value={formatCount(stats.downloads)} href={releasesUrl} />}
        {stats && stats.stars > 0 && <StatBadge label="stars" value={formatCount(stats.stars)} href="https://github.com/apinizer/testnizer" />}
        <StatBadge label="telemetry" value="none" />
      </div>

      <div class="mt-3 flex justify-center" data-fold="ph">
        <ProductHuntBadge label="Upvote on Product Hunt" />
      </div>

      <ul class="mx-auto mt-8 grid max-w-6xl grid-cols-1 gap-3 text-left sm:grid-cols-2 lg:grid-cols-4" data-fold="pillars">
        {pillars.map((pl) => (
          <li>
            <a
              href={pl.href}
              class="group flex h-full items-start gap-3 rounded-card border border-border bg-bg/70 p-4 transition-colors hover:border-border-strong hover:bg-bg-muted"
            >
              <span class="grid h-8 w-8 flex-shrink-0 place-items-center rounded-lg bg-accent-light text-accent-text">
                <Fragment set:html={pl.icon} />
              </span>
              <span class="min-w-0">
                <span class="flex items-center gap-1.5 text-sm font-semibold text-text">
                  {pl.title}
                  <span class="text-text-soft transition-colors group-hover:text-accent-text">
                    <Fragment set:html={icons.arrowRight} />
                  </span>
                </span>
                <span class="mt-1 block text-xs leading-relaxed text-text-muted">{pl.body}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class="mx-auto mt-5 max-w-3xl text-xs leading-relaxed text-text-soft">
        Built by <a href="https://apinizer.com" target="_blank" rel="noopener" class="underline decoration-dotted underline-offset-2 hover:text-text-muted">Apinizer</a> for banking, government, insurance and healthcare — teams whose production credentials must never leave the machine.
      </p>
    </div>
  </section>

  <!-- Product screenshot -->
  <section class="border-b border-border bg-bg-soft py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="overflow-hidden rounded-card border border-border bg-bg shadow-2xl shadow-blue-500/10 ring-1 ring-white/5">
        <img
          src="/testnizer-overview.png"
          alt="Testnizer running with the Swagger Petstore OpenAPI loaded — sidebar shows the imported endpoint tree, the request pane shows a POST /pet with a JSON body, the response pane shows a 200 OK with the returned pet object."
          width="1399"
          height="871"
          loading="eager"
          decoding="async"
          class="block h-auto w-full"
        />
      </div>
      <p class="mt-4 text-center text-sm text-text-soft">
        Imported a Swagger spec, ran a POST, got a 200. No account, no cloud sync, no telemetry.
      </p>
    </div>
  </section>

  <!-- New in 1.6.0 -->
  <section class="border-b border-border py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-wider text-accent-text">New in 1.6.0</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-text md:text-4xl">
          AI, MCP and streaming.
        </h2>
        <p class="mt-4 text-base leading-relaxed text-text-muted">
          Test the servers your agents talk to, check them for security problems, and mock the model, the tools and the event stream when you would rather not call the real ones.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
        {newIn160.map((n) => (
          <a href="/ai-mcp" class="group flex flex-col rounded-card border border-border bg-bg-soft p-6 transition-colors hover:border-border-strong">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent-light text-accent-text">
              <Fragment set:html={n.icon} />
            </span>
            <h3 class="mt-4 text-base font-semibold text-text">{n.title}</h3>
            <p class="mt-1.5 flex-1 text-sm leading-relaxed text-text-muted">{n.body}</p>
          </a>
        ))}
      </div>

      <div class="mt-8 flex flex-col items-center gap-3">
        <a
          href="/ai-mcp"
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-bg px-5 py-3 text-sm font-medium text-text transition-colors hover:bg-bg-muted"
        >
          See AI, MCP &amp; streaming
          <Fragment set:html={icons.arrowRight} />
        </a>
        <p class="max-w-2xl text-center text-xs leading-relaxed text-text-soft">
          AI Chat sends your messages straight to the provider you configure, and the MCP client connects to the server you point it at — nothing goes through us. The mock servers need no network at all.
        </p>
      </div>
    </div>
  </section>

  <!-- The four guarantees -->
  <section class="py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-wider text-accent-text">The four guarantees</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-text md:text-4xl">
          Your data never leaves your machine.
        </h2>
        <p class="mt-4 text-base leading-relaxed text-text-muted">
          Not when you decode a JWT. Not when you sign an XML envelope. Not when you check for updates. Not ever.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
        {guarantees.map((g) => (
          <GuaranteeCard icon={g.icon} title={g.title} body={g.body} />
        ))}
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section class="border-y border-border bg-bg-soft py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-wider text-accent-text">Why offline matters</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-text md:text-4xl">
          Where your data actually goes.
        </h2>
      </div>

      <div class="mt-12 overflow-hidden rounded-card border border-border bg-bg">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-border bg-bg-muted text-left">
              <th class="px-5 py-3.5 font-medium text-text-muted">Concern</th>
              <th class="px-5 py-3.5 font-medium text-text-muted">SaaS API clients</th>
              <th class="px-5 py-3.5 font-medium text-accent-text">Testnizer</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <tr>
              <td class="px-5 py-3.5 font-medium text-text">Where collections live</td>
              <td class="px-5 py-3.5 text-text-muted">Vendor cloud workspace</td>
              <td class="px-5 py-3.5 text-text">Local SQLite on your disk</td>
            </tr>
            <tr>
              <td class="px-5 py-3.5 font-medium text-text">Where tokens are stored</td>
              <td class="px-5 py-3.5 text-text-muted">Synced to vendor servers</td>
              <td class="px-5 py-3.5 text-text">OS keychain (Keychain / DPAPI / libsecret)</td>
            </tr>
            <tr>
              <td class="px-5 py-3.5 font-medium text-text">JWT decode</td>
              <td class="px-5 py-3.5 text-text-muted">Web app sends token to a remote service</td>
              <td class="px-5 py-3.5 text-text">Local crypto — token stays in process</td>
            </tr>
            <tr>
              <td class="px-5 py-3.5 font-medium text-text">WS-Security sign / encrypt</td>
              <td class="px-5 py-3.5 text-text-muted">Online tools or separate desktop app</td>
              <td class="px-5 py-3.5 text-text">Built-in main process with xml-crypto + Node crypto</td>
            </tr>
            <tr>
              <td class="px-5 py-3.5 font-medium text-text">Telemetry</td>
              <td class="px-5 py-3.5 text-text-muted">On by default</td>
              <td class="px-5 py-3.5 text-text">None — and no opt-in either</td>
            </tr>
            <tr>
              <td class="px-5 py-3.5 font-medium text-text">Air-gapped network</td>
              <td class="px-5 py-3.5 text-text-muted">Doesn't work</td>
              <td class="px-5 py-3.5 text-text">Works</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Protocols -->
  <section class="py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-wider text-accent-text">Protocols</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-text md:text-4xl">
          Test what enterprise systems actually run on.
        </h2>
        <p class="mt-4 text-base leading-relaxed text-text-muted">
          Not just REST. SOAP envelopes, gRPC streams, WebSocket and MQTT sessions, event streams and MCP servers — first-class, on-device.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-card border border-border bg-border md:grid-cols-2 lg:grid-cols-5">
        {protocols.map((p) => (
          <div class="bg-bg p-6">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent-light text-accent-text">
              <Fragment set:html={p.icon} />
            </div>
            <h3 class="mt-4 text-base font-semibold text-text">{p.name}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-text-muted">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tools strip -->
  <section class="border-t border-border bg-bg-soft py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid items-center gap-10 md:grid-cols-2">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-accent-text">Built-in tools</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-text md:text-4xl">
            All the things you'd otherwise paste into jwt.io.
          </h2>
          <p class="mt-4 text-base leading-relaxed text-text-muted">
            Every utility runs on-device. No round-trips to a third-party site to "format your JSON" or "decode your token." If the network is off, the tools still work.
          </p>
        </div>
        <ul class="grid grid-cols-2 gap-2.5">
          {tools.map((t) => (
            <li class="flex items-center gap-2.5 rounded-lg border border-border bg-bg px-3.5 py-2.5 text-sm text-text">
              <span class="text-accent-text">
                <Fragment set:html={icons.check} />
              </span>
              {t}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Compatibility / migration -->
  <section class="py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-wider text-accent-text">Migration</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-text md:text-4xl">
          Bring your existing collections.
        </h2>
        <p class="mt-4 text-base leading-relaxed text-text-muted">
          Drop in any Postman file and Testnizer works out what it is — scripts, variables and saved examples included — and ends the import with a report of what was converted or skipped. A project exports back to Postman v2.1 or v3, OpenAPI 3 and Insomnia.
        </p>
      </div>

      <div class="mx-auto mt-10 flex max-w-3xl flex-wrap items-center justify-center gap-2">
        {migrationFormats.map((fmt) => (
          <span class="rounded-full border border-border bg-bg px-3.5 py-1.5 text-xs font-medium text-text-muted">
            {fmt}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Enterprise -->
  <section class="border-t border-border bg-bg-soft">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <div class="rounded-2xl border border-border bg-bg p-8 md:p-10">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div class="md:flex-1">
            <div class="mb-2 inline-flex items-center gap-2 rounded-full border border-border bg-bg-soft px-3 py-1 text-xs font-medium text-text-muted">
              <Fragment set:html={icons.building} />
              For regulated industries
            </div>
            <h2 class="text-2xl font-semibold tracking-tight text-text md:text-3xl">
              Need enterprise support?
            </h2>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-text-muted md:text-base">
              The free binary is distributed as-is, with no maintenance or security-patch obligation. If your organization needs paid support, response-time SLAs, on-premise deployment assistance, training, or custom development — typical for banking, public sector, defense, healthcare, and regulated infrastructure — get in touch.
            </p>
          </div>
          <div class="shrink-0">
            <a
              href="https://github.com/apinizer/testnizer/issues/new?labels=enterprise&title=Enterprise+support+inquiry"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-medium text-white shadow-sm transition-colors hover:bg-accent-hover"
            >
              Open an inquiry
              <Fragment set:html={icons.arrowRight} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="border-t border-border">
    <div class="mx-auto max-w-4xl px-6 py-24 text-center">
      <h2 class="text-3xl font-semibold tracking-tight text-text md:text-4xl">
        Free. No vendor lock-in. No subscription.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-text-muted">
        Testnizer is built and maintained by Apinizer. There is no "pro" tier, no cloud workspace upsell, no waitlist for real features. We made it because we needed it ourselves.
      </p>
      <div class="mt-8 flex justify-center">
        <a
          href="/download"
          class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-medium text-white shadow-sm transition-colors hover:bg-accent-hover"
        >
          Download Testnizer
          <Fragment set:html={icons.arrowRight} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
