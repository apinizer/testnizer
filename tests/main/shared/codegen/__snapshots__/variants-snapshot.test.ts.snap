exports[`objective-c / NSURLSession (objc-nsurlsession) > non-default options 1`] = `
"#import <Foundation/Foundation.h>

int main(int argc, const char * argv[]) {
   @autoreleasepool {
      dispatch_semaphore_t sema = dispatch_semaphore_create(0);

      NSMutableURLRequest *request = [NSMutableURLRequest requestWithURL:[NSURL URLWithString:@"https://api.example.com/items"]
         cachePolicy:NSURLRequestUseProtocolCachePolicy
         timeoutInterval:3.0];
      NSDictionary *headers = @{
         @"X-Trace": @"abc",
         @"Content-Type": @"application/json"
      };
      [request setAllHTTPHeaderFields:headers];
      [request setHTTPBody:[@"{\\"a\\":1}" dataUsingEncoding:NSUTF8StringEncoding]];
      [request setHTTPMethod:@"POST"];

      NSURLSession *session = [NSURLSession sharedSession];
      NSURLSessionDataTask *dataTask = [session dataTaskWithRequest:request
      completionHandler:^(NSData *data, NSURLResponse *response, NSError *error) {
         if (error) {
            NSLog(@"%@", error);
         } else {
            NSLog(@"%@", [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding]);
         }
         dispatch_semaphore_signal(sema);
      }];
      [dataTask resume];
      dispatch_semaphore_wait(sema, DISPATCH_TIME_FOREVER);
   }
   return 0;
}"
`;

