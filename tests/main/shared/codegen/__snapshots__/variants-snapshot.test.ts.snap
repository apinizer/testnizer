exports[`csharp / HttpClient (csharp) > basic-auth-secret-placeholder 1`] = `
"using System.Net.Http;

var client = new HttpClient();

var request = new HttpRequestMessage(HttpMethod.Get, "https://api.example.com/secure");
request.Headers.Add("Authorization", "Basic " + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes("admin:{{pass}}")));

var response = await client.SendAsync(request);
var body = await response.Content.ReadAsStringAsync();
Console.WriteLine(body);"
`;

