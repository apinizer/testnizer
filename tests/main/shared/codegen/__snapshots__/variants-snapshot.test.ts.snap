"import 'dart:io';
import 'package:dio/dio.dart';

void main() async {
  var headers = {
    "Content-Type": "application/octet-stream",
  };
  var file = File("/tmp/photo.png");
  headers[Headers.contentLengthHeader] = (await file.length()).toString();
  var data = file.openRead();
  var dio = Dio();
  var response = await dio.request(
    "https://api.example.com/files/photo.png",
    options: Options(
      method: "PUT",
      headers: headers,
    ),
    data: data,
  );

  print(response.statusCode);
  print(response.data);
}"
`;

