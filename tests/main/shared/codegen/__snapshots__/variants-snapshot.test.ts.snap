exports[`swift / URLSession (swift) > basic-auth-secret-placeholder 1`] = `
"import Foundation

let url = URL(string: "https://api.example.com/secure")!
var request = URLRequest(url: url)
request.httpMethod = "GET"
request.setValue("Basic " + Data("admin:{{pass}}".utf8).base64EncodedString(), forHTTPHeaderField: "Authorization")

let task = URLSession.shared.dataTask(with: request) { data, response, error in
    guard let data = data else { return }
    print(String(data: data, encoding: .utf8) ?? "")
}
task.resume()"
`;

exports[`swift / URLSession (swift) > graphql-query 1`] = `
"import Foundation

let url = URL(string: "https://api.example.com/graphql")!
var request = URLRequest(url: url)
request.httpMethod = "POST"
request.setValue("tn", forHTTPHeaderField: "X-Client")
request.setValue("application/json", forHTTPHeaderField: "Content-Type")
request.httpBody = "{\\"query\\":\\"query User($id: ID!) {\\\\n  user(id: $id) { name }\\\\n}\\",\\"variables\\":{\\"id\\":\\"7\\"}}".data(using: .utf8)

let task = URLSession.shared.dataTask(with: request) { data, response, error in
    guard let data = data else { return }
    print(String(data: data, encoding: .utf8) ?? "")
}
task.resume()"
`;

