exports[`nodejs / Native (nodejs-native) > post-form-data-text-and-file 1`] = `
"const https = require('follow-redirects').https;
const FormData = require('form-data');
const fs = require('fs');

const form = new FormData();
form.append('title', 'My report');
form.append('file', fs.createReadStream('/tmp/report.pdf'));

const options = {
  'method': 'POST',
  'headers': form.getHeaders(),
  'maxRedirects': 20
};

const req = https.request('https://api.example.com/upload', options, (res) => {
  const chunks = [];
  res.on('data', (chunk) => chunks.push(chunk));
  res.on('end', () => console.log(Buffer.concat(chunks).toString()));
});

req.on('error', (error) => console.error(error));
form.pipe(req);"
`;

