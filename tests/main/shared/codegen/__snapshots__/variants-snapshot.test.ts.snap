exports[`kotlin / OkHttp (kotlin) > graphql-query 1`] = `
"val client = OkHttpClient()

val mediaType = "application/json".toMediaType()
val body = "{\\"query\\":\\"query User(\\$id: ID!) {\\\\n  user(id: \\$id) { name }\\\\n}\\",\\"variables\\":{\\"id\\":\\"7\\"}}".toRequestBody(mediaType)

val request = Request.Builder()
    .url("https://api.example.com/graphql")
    .method("POST", body)
    .addHeader("X-Client", "tn")
