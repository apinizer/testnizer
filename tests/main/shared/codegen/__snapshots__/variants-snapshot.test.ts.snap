exports[`python / http.client (python-http-client) > placeholders-unresolved 1`] = `
"import http.client
from urllib.parse import urlsplit

url = urlsplit('{{baseUrl}}/users/{{userId}}?token={{token}}&page={{page}}')
conn = http.client.HTTPSConnection(url.netloc)
payload = '{"id":"{{userId}}"}'
headers = {
    'X-Env': '{{envName}}',
    'Authorization': 'Bearer {{token}}',
    'Content-Type': 'application/json',
}
conn.request('POST', url.path + ('?' + url.query if url.query else ''), payload, headers)
res = conn.getresponse()
data = res.read()
print(data.decode('utf-8'))"
`;

exports[`python / http.client (python-http-client) > post-form-data-text-and-file 1`] = `
"import http.client

conn = http.client.HTTPSConnection('api.example.com')
boundary = 'TestnizerFormBoundary7MA4YWxkTrZu0gW'

def part(name, value, filename=None):
    head = '--' + boundary + '\\r\\nContent-Disposition: form-data; name="' + name + '"'
    if filename:
        head += '; filename="' + filename + '"\\r\\nContent-Type: application/octet-stream'
    return head.encode() + b'\\r\\n\\r\\n' + value + b'\\r\\n'

payload = b''.join([
    part('title', 'My report'.encode()),
    part('file', open('/tmp/report.pdf', 'rb').read(), 'report.pdf'),
]) + ('--' + boundary + '--\\r\\n').encode()
headers = {
    'Content-Type': 'multipart/form-data; boundary=' + boundary,
}
conn.request('POST', '/upload', payload, headers)
res = conn.getresponse()
data = res.read()
print(data.decode('utf-8'))"
`;

