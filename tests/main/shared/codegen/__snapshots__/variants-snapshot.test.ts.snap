exports[`nodejs / Native (nodejs-native) > auth-apikey-header 1`] = `
"const https = require('follow-redirects').https;

const options = {
  'method': 'GET',
  'headers': {
    'X-API-Key': 'key-1'
  },
  'maxRedirects': 20
};

const req = https.request('https://api.example.com/secure', options, (res) => {
  const chunks = [];
  res.on('data', (chunk) => chunks.push(chunk));
  res.on('end', () => console.log(Buffer.concat(chunks).toString()));
});

req.on('error', (error) => console.error(error));
req.end();"
`;

