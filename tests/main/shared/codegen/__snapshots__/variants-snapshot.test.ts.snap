exports[`objective-c / NSURLSession (objc-nsurlsession) > basic-auth-secret-placeholder 1`] = `
"#import <Foundation/Foundation.h>

dispatch_semaphore_t sema = dispatch_semaphore_create(0);

NSMutableURLRequest *request = [NSMutableURLRequest requestWithURL:[NSURL URLWithString:@"https://api.example.com/secure"]
  cachePolicy:NSURLRequestUseProtocolCachePolicy
  timeoutInterval:60.0];
NSString *credentials = [[@"admin:{{pass}}" dataUsingEncoding:NSUTF8StringEncoding] base64EncodedStringWithOptions:0];
[request setValue:[@"Basic " stringByAppendingString:credentials] forHTTPHeaderField:@"Authorization"];
[request setHTTPMethod:@"GET"];

