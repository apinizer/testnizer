exports[`ocaml / Cohttp (ocaml-cohttp) > auth-apikey-header 1`] = `
"open Lwt
open Cohttp
open Cohttp_lwt_unix

let reqBody =
  let uri = Uri.of_string "https://api.example.com/secure" in
  let headers = Header.init ()
    |> fun h -> Header.add h "X-API-Key" "key-1"
  in
  Client.call ~headers (Code.method_of_string "GET") uri >>= fun (_resp, body) ->
  body |> Cohttp_lwt.Body.to_string >|= fun body -> body

let () =
  let respBody = Lwt_main.run reqBody in
  print_endline respBody"
`;

