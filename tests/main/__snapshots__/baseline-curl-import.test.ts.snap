exports[`baseline cURL export — export:curl IPC > GET no extras 1`] = `
{
  "data": "curl \\
  'https://api.example.com/users'",
  "success": true,
}
`;

exports[`baseline cURL export — export:curl IPC > POST json + headers + bearer 1`] = `
{
  "data": "curl \\
  -X POST \\
  'https://api.example.com/users' \\
  -H 'Content-Type: application/json' \\
  -H 'Authorization: Bearer tok' \\
  -d '{"name":"it'\\''s"}'",
  "success": true,
}
`;

exports[`baseline cURL export — export:curl IPC > basic auth + cookies + insecure 1`] = `
{
  "data": "curl \\
  'https://x.test' \\
  -u 'a:b:c' \\
  -b 'a=1; b=2' \\
  -k",
  "success": true,
}
`;

exports[`baseline cURL export — export:curl IPC > form-data text + file 1`] = `
{
  "data": "curl \\
  -X POST \\
  'https://x.test' \\
  -F 'title=T' \\
  -F 'f=@/tmp/a.png'",
  "success": true,
}
`;

exports[`baseline cURL export — export:curl IPC > urlencoded rows 1`] = `
{
  "data": "curl \\
  -X POST \\
  'https://x.test' \\
  --data-urlencode 'q=a b'",
  "success": true,
}
`;

