exports[`baseline Postman v2.1 — import -> DB -> export > export:postman output 1`] = `
{
  "collection": {
    "auth": {
      "bearer": [
        {
          "key": "token",
          "type": "string",
          "value": "{{collectionToken}}",
        },
      ],
      "type": "bearer",
    },
    "event": [
      {
        "listen": "prerequest",
        "script": {
          "exec": [
            "pm.variables.set('collPre', '1');",
          ],
          "type": "text/javascript",
        },
      },
      {
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('collection test', function () {",
            "  pm.expect(1).to.equal(1);",
            "});",
          ],
          "type": "text/javascript",
        },
      },
    ],
    "info": {
      "_postman_id": "pm-baseline-1",
      "description": "Constructed fixture for the Postman parity baseline (not a third-party file).",
      "name": "Baseline Project",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    },
    "item": [
      {
        "auth": {
          "apikey": [
            {
              "key": "key",
              "type": "string",
              "value": "X-Folder-Key",
            },
            {
              "key": "value",
              "type": "string",
              "value": "{{folderKey}}",
            },
            {
              "key": "in",
              "type": "string",
              "value": "header",
            },
          ],
          "type": "apikey",
        },
        "event": [
          {
            "listen": "prerequest",
            "script": {
              "exec": [
                "console.log('users folder pre');",
              ],
              "type": "text/javascript",
            },
          },
          {
            "listen": "test",
            "script": {
              "exec": [
                "console.log('users folder test');",
              ],
              "type": "text/javascript",
            },
          },
        ],
        "item": [
          {
            "item": [
              {
                "name": "Create post (raw xml)",
                "request": {
                  "auth": {
                    "type": "noauth",
                  },
                  "body": {
                    "mode": "raw",
                    "options": {
                      "raw": {
                        "language": "xml",
                      },
                    },
                    "raw": "<post><title>Hello</title></post>",
                  },
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/xml",
                    },
                  ],
                  "method": "POST",
                  "url": {
                    "path": [
                      "posts",
                    ],
                    "raw": "{{baseUrl}}/posts",
                  },
                },
              },
              {
                "name": "Update post (raw text, PUT)",
                "request": {
                  "body": {
                    "mode": "raw",
                    "options": {
                      "raw": {
                        "language": "text",
                      },
                    },
                    "raw": "plain text body",
                  },
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "text/plain",
                    },
                  ],
                  "method": "PUT",
                  "url": {
                    "path": [
                      "posts",
                      "1",
                    ],
                    "raw": "{{baseUrl}}/posts/1",
                  },
                },
              },
            ],
            "name": "Posts",
          },
          {
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('status is 200', function () {",
                    "  pm.response.to.have.status(200);",
                    "});",
                  ],
                  "type": "text/javascript",
                },
              },
            ],
            "name": "List users",
            "request": {
              "description": "Lists users",
              "header": [
                {
                  "key": "Accept",
                  "value": "application/json",
                },
                {
                  "disabled": true,
                  "key": "X-Disabled",
                  "value": "nope",
                },
              ],
              "method": "GET",
              "url": {
                "path": [
                  "users?page=1&trace=x",
                ],
                "query": [
                  {
                    "key": "page",
                    "value": "1",
                  },
                  {
                    "disabled": true,
                    "key": "debug",
                    "value": "1",
                  },
                  {
                    "description": "trace id",
                    "key": "trace",
                    "value": "x",
                  },
                ],
                "raw": "{{baseUrl}}/{{apiVersion}}/users?page=1&trace=x",
              },
            },
          },
          {
            "event": [
              {
                "listen": "prerequest",
                "script": {
                  "exec": [
                    "pm.environment.set('ts', Date.now());",
                  ],
                  "type": "text/javascript",
                },
              },
            ],
            "name": "Create user (raw json)",
            "request": {
              "auth": {
                "basic": [
                  {
                    "key": "username",
                    "type": "string",
                    "value": "admin",
                  },
                  {
                    "key": "password",
                    "type": "string",
                    "value": "{{adminPass}}",
                  },
                ],
                "type": "basic",
              },
              "body": {
                "mode": "raw",
                "options": {
                  "raw": {
                    "language": "json",
                  },
                },
                "raw": "{
  "name": "Ada",
  "active": true,
  "tags": ["a", "b"]
}",
              },
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                },
              ],
              "method": "POST",
              "url": {
                "path": [
                  "users",
                ],
                "raw": "{{baseUrl}}/users",
              },
            },
          },
        ],
        "name": "Users",
      },
      {
        "item": [
          {
            "name": "Login (urlencoded)",
            "request": {
              "body": {
                "mode": "urlencoded",
                "urlencoded": [
                  {
                    "key": "user",
                    "value": "ada",
                  },
                  {
                    "key": "pass",
                    "value": "p@ss word",
                  },
                  {
                    "disabled": true,
                    "key": "remember",
                    "value": "1",
                  },
                ],
              },
              "header": [],
              "method": "POST",
              "url": {
                "path": [
                  "login",
                ],
                "raw": "{{baseUrl}}/login",
              },
            },
          },
          {
            "name": "Upload (formdata)",
            "request": {
              "body": {
                "formdata": [
                  {
                    "key": "title",
                    "type": "text",
                    "value": "My report",
                  },
                  {
                    "disabled": true,
                    "key": "notes",
                    "type": "text",
                    "value": "skip me",
                  },
                  {
                    "key": "file",
                    "src": "/tmp/report.pdf",
                    "type": "file",
                  },
                ],
                "mode": "formdata",
              },
              "header": [],
              "method": "POST",
              "url": {
                "path": [
                  "upload",
                ],
                "raw": "{{baseUrl}}/upload",
              },
            },
          },
          {
            "name": "GraphQL query",
            "request": {
              "body": {
                "graphql": {
                  "query": "query Q($id: ID!) { user(id: $id) { id name } }",
                  "variables": "{"id":"42"}",
                },
                "mode": "graphql",
              },
              "header": [],
              "method": "POST",
              "url": {
                "path": [
                  "graphql",
                ],
                "raw": "{{baseUrl}}/graphql",
              },
            },
          },
        ],
        "name": "Forms",
      },
      {
        "item": [
          {
            "name": "Bearer request",
            "request": {
              "auth": {
                "bearer": [
                  {
                    "key": "token",
                    "type": "string",
                    "value": "{{myToken}}",
                  },
                ],
                "type": "bearer",
              },
              "header": [],
              "method": "GET",
              "url": {
                "path": [
                  "me",
                ],
                "raw": "{{baseUrl}}/me",
              },
            },
          },
          {
            "name": "API key in query",
            "request": {
              "auth": {
                "apikey": [
                  {
                    "key": "key",
                    "type": "string",
                    "value": "api_key",
                  },
                  {
                    "key": "value",
                    "type": "string",
                    "value": "{{apiKey}}",
                  },
