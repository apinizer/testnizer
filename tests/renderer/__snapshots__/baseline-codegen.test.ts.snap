"require 'net/http'
require 'uri'
require 'json'

uri = URI.parse('https://api.example.com/echo')
request = Net::HTTP::Post.new(uri)
request['Content-Type'] = 'application/json'
request.body = "{\\"msg\\":\\"it's \\\\\\"quoted\\\\\\"\\",\\"path\\":\\"C:\\\\\\\\tmp\\"}"

response = Net::HTTP.start(uri.hostname, uri.port, use_ssl: uri.scheme == "https") do |http|
  http.request(request)
end

puts response.body"
`;

exports[`baseline code generation — all languages x request matrix > special-chars-json-body-quotes > swift 1`] = `
"import Foundation

let url = URL(string: "https://api.example.com/echo")!
var request = URLRequest(url: url)
request.httpMethod = "POST"
request.setValue("application/json", forHTTPHeaderField: "Content-Type")
request.httpBody = "{\\"msg\\":\\"it's \\\\\\"quoted\\\\\\"\\",\\"path\\":\\"C:\\\\\\\\tmp\\"}".data(using: .utf8)

let task = URLSession.shared.dataTask(with: request) { data, response, error in
    guard let data = data else { return }
    print(String(data: data, encoding: .utf8) ?? "")
}
task.resume()"
`;

