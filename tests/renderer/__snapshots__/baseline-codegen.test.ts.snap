exports[`baseline code generation — all languages x request matrix > post-form-data-text-and-file > go 1`] = `
"package main

import (
	"bytes"
	"fmt"
	"io"
	"mime/multipart"
	"net/http"
	"os"
)

func main() {
	payload := &bytes.Buffer{}
	writer := multipart.NewWriter(payload)
	_ = writer.WriteField("title", "My report")
	file1, _ := os.Open("/tmp/report.pdf")
	defer file1.Close()
	part1, _ := writer.CreateFormFile("file", "report.pdf")
	_, _ = io.Copy(part1, file1)
	_ = writer.Close()
	req, _ := http.NewRequest("POST", "https://api.example.com/upload", payload)
	req.Header.Set("Content-Type", writer.FormDataContentType())

	res, _ := http.DefaultClient.Do(req)
	defer res.Body.Close()
	body, _ := io.ReadAll(res.Body)
	fmt.Println(string(body))
}"
`;

